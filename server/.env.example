NODE_ENV=production
PORT=3101
CORS_ORIGIN=https://satglobal.site
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start

# Durable database for Vercel (automatically injected when Turso Cloud is connected)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Runtime/VPS embedded SQLite fallback
DATA_DIR=/var/www/satglobal_si_usr/data/app-data/satglobal-bus
# Optional override; defaults to $DATA_DIR/sat_database.sqlite
DATABASE_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAYMENT_BOT_TOKEN=
PAYMENT_CHAT_ID=
